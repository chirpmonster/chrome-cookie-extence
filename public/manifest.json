{
  "manifest_version": 3,
  "name": "Chrome Cookie携带问题",
  "version": "0.3.0",
  "description": "Chrome 140+的cookie携带问题",
  "icons": {
    "16": "icons/icon64.png",
    "32": "icons/icon64.png",
    "48": "icons/icon64.png",
    "128": "icons/icon64.png"
  },
  "background": {
    "service_worker": [
      "background.js"
    ],
    "persistent": true
  },
  "action": {
    "default_title": "解决Chrome浏览器Cookie携带问题",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "*://*/",
    "cookies",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*/"
  ],
  "default_domains": [
    "localhost",
    ".baidu.com",
    "www.baidu.com"
  ],
  "default_fobidden_domains": [
    "google.com",
    "gitlab.com",
    "mfp.com",
    "mail.qq.com",
    "csdn.com",
    "cnblogs.com"
  ]
}